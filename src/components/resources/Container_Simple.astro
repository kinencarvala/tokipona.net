---
import FilterFor from "@/components/resources/FilterFor.astro";
const { name, category, withImg } = Astro.props;

---
<style>
.reading {
    display: grid;
    row-gap: 1em;
			

    .cat {
        display: none;
    }

    li {
        display: block;

        p::before{
            content: '~ '
        }

        p {
            display: inline;
        }
    }
    

}


</style>

		<ul class="reading">

						<FilterFor
                        name={name} category={category} withImg={false}></FilterFor>
            <slot />

		</ul>
