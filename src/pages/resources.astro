---
import Layout from "@/layouts/Layout.astro";
import resources from "../data/resources.yaml";
import SinKulupu from "@/components/resources/SinKulupu.astro";
import InfoSitelenToki from "@/components/resources/Info_SitelenToki.astro";
import FilterFor from "@/components/resources/FilterFor.astro";

import Container_Nested from "@/components/resources/Container_Nested.astro";
import ContainerSitelenToki from "@/components/resources/Container_SitelenToki.astro";
import SeeMore from "@/components/resources/SeeMore.astro";
import ContainerCircles from "@/components/resources/Container_Circles.astro";
import Container_CubedBullets from "@/components/resources/Container_CubedBullets.astro";
import Container_Thumbnail from "@/components/resources/Container_Thumbnail.astro";

---

<Layout title={"o pali"} description={"."} draft>
	<style>
		
		section :global(h2) {
			text-align: left;
			padding-inline-start: 1em;
			font-size: 1.7em;
		}
		section :global(h3) {
			text-align: center;
		}

		p.uncontained {
			padding: 0.5em 1.5em;
		}
	
		
		.communities-flex .more {
			max-width: 30em;
			margin: 0 auto;
			display: flex;
			flex-direction: column;
			justify-content: space-evenly;
		}
		@media (min-width: 30em) {
			.communities-flex {
				display: grid;
				grid-template-columns: minmax(10em, 1.5fr) minmax(5em, 1fr);
			}
		}
	</style>
	<section style="grid-area: left;">
		<h1>Resources</h1>

		<h2>Communities</h2>

				<h3>Online</h3>
				<ContainerCircles
				name="Online"
				category="community"
				withImg={true}></ContainerCircles>


		
		<div class="communities-flex">
			<div>
				<h3>In-Person</h3>


								<Container_CubedBullets
				name="In-Person"
				category="inperson"
				withImg={true}></Container_CubedBullets>

			</div>
			<SeeMore>

				<h3>More communities</h3>
				<p class="horizon">
					A full list of all known Toki Pona communities is maintained on <a
						href="https://sona.pona.la/wiki/Communities"
						>the sona pona wiki's "<strong>Communities</strong>" article</a
					>
				</p>

				<p>
					If you're looking for language-specific or place-specific communities,
					or communities on platforms not listed here, there's a good chance
					that it is on this list.
				</p>

			</SeeMore>

		</div>

		<SinKulupu />
		<h2>Courses</h2>

		<ContainerSitelenToki name="Courses" withImg={true} category="course">
			<li>
				<SeeMore>
					<Container_Nested
					name="courses"
					category="course"
					withImg={false}>
						<p>
							Even more courses listed on sona.pona.la, <br /><a
								href="https://sona.pona.la/wiki/Learning_resources#Video_lessons"
								>Learning Resources</a
							>
						</p>
					</Container_Nested>
				</SeeMore>
			</li>
		</ContainerSitelenToki>

		<h2>Reference</h2>

		<ContainerSitelenToki
			name="Reference"
			withImg={true}
			category="reference"
		>
		</ContainerSitelenToki>


		<h2>Reading Practice</h2>

		<ul class="courses">
			{
				resources
					.filter((r) => r.category === "reading")
					.map((r) => <InfoSitelenToki entry={r} />)
			}
		</ul>

		<h2>Listening Practice</h2>


		<p class="uncontained">There are Toki Pona vloggers, streamers, and presenters on YouTube, but they can but a little hard to find. Hopefully these organized (and regularly updated) <strong>playlists</strong> can help!</p>

		<Container_Thumbnail
			withImg={true}
			category="playlist"
		>
		
	</ContainerThumbnail>





			<ContainerSitelenToki
			name="Reference"
			withImg={true}
			category="listening"
		>
				
		</ContainerSitelenToki>




	</section>
	<section style="grid-area: right;" class="prose">
		<p>Sidebar Content Here</p>
	</section>
</Layout>
