---
import Layout from "@/layouts/Layout.astro";
import SinKulupu from "@/components/resources/SinKulupu.astro";
import Container_Nested from "@/components/resources/Container_Nested.astro";
import ContainerSitelenToki from "@/components/resources/Container_SitelenToki.astro";
import ContainerSitelenLiliToki from "@/components/resources/Container_SitelenLiliToki.astro";

import SeeMore from "@/components/resources/SeeMore.astro";
import ContainerCircles from "@/components/resources/Container_Circles.astro";
import Container_CubedBullets from "@/components/resources/Container_CubedBullets.astro";
import Container_Simple from "@/components/resources/Container_Simple.astro";
import Container_Thumbnail from "@/components/resources/Container_Thumbnail.astro";

---

<Layout title={"o pali"} description={"."} draft>
	<style>
		
		section :global(h2) {
			text-align: left;
			padding-inline-start: 1em;
			font-size: 1.7em;
		}
		section :global(h3) {
			text-align: center;
		}

		p.uncontained {
			padding: 0.5em 1.5em;
		}
	
		
		.communities-flex .more {
			max-width: 30em;
			margin: 0 auto;
			display: flex;
			flex-direction: column;
			justify-content: space-evenly;
		}
		@media (min-width: 30em) {
			.communities-flex {
				display: grid;
				grid-template-columns: minmax(10em, 1.5fr) minmax(5em, 1fr);
			}
		}
	</style>
	<section style="grid-area: left;">
		<h1>Resources</h1>

		<h2>Communities</h2>

				<h3>Online</h3>
				<ContainerCircles
				name="Online"
				category="community"
				withImg={true}></ContainerCircles>


		
		<div class="communities-flex">
			<div>
				<h3>In-Person</h3>


								<Container_CubedBullets
				name="In-Person"
				category="inperson"
				withImg={true}></Container_CubedBullets>

			</div>
			<SeeMore>

				<h3>More communities</h3>
				<p class="horizon">
					A full list of all known Toki Pona communities is maintained on <a
						href="https://sona.pona.la/wiki/Communities"
						>the sona pona wiki's "<strong>Communities</strong>" article</a
					>
				</p>

				<p>
					If you're looking for language-specific or place-specific communities,
					or communities on platforms not listed here, there's a good chance
					that it is on this list.
				</p>

			</SeeMore>

		</div>

		<SinKulupu />
		<h2>Courses</h2>

		<ContainerSitelenToki name="Courses" withImg={true} category="course">
			<li>
				<SeeMore>
					<Container_Nested
					name="courses"
					category="course"
					withImg={false}>
						<p>
							Even more courses listed on sona.pona.la, <br /><a
								href="https://sona.pona.la/wiki/Learning_resources#Video_lessons"
								>Learning Resources</a
							>
						</p>
					</Container_Nested>
				</SeeMore>
			</li>
		</ContainerSitelenToki>

		<h2>Reference</h2>

		<ContainerSitelenLiliToki
			name="Reference"
			withImg={true}
			category="reference"
		>
		</ContainerSitelenLiliToki>


		<h2>Reading Practice</h2>


				<p class="uncontained">There is lots of Toki Pona material available for free online. Individual titles can be found listed at sona pona (<a href="https://sona.pona.la/wiki/Literature">Literature</a> | <a href="https://sona.pona.la/wiki/List_of_works_by_length">List of works by length</a> | <a href="https://sona.pona.la/wiki/Comics">Comics</a>) and on the digital library, <a href="https://lipu.pona.la/">lipu Lapo</a>. Besides lipu Lapo, we've listed a couple of websites that host multiple works below:</p>

				




				<Container_Simple
				name="Online"
				category="reading"
				withImg={false}></Container_Simple>

								<p class="uncontained"> Another excellent way to practice reading in Toki Pona is through video games: speakers made <a href="https://itch.io/jam/tu/results">32 games</a> in the 2026 pali musi game jam, and <a href="https://itch.io/jam/mu/results">34 games</a> in 2025. There are other titles of both original and translated available at sona.pona.la's <a href="https://sona.pona.la/wiki/Games#Video_games">Games</a> article.</p>


				<p class="uncontained"> <strong>Be careful about purchasing reading material from Amazon</strong>; a good portion of the titles available there are generated by LLMs and are almost completely incoherent, published by people who do not know Toki Pona and are seeking to capitalize off of this niche market.</p>

		<h2>Listening Practice</h2>


		<p class="uncontained">There are Toki Pona vloggers, streamers, and presenters on YouTube, but they can but a little hard to find. Hopefully these organized (and regularly updated) <strong>playlists</strong> can help!</p>

		<Container_Thumbnail
			withImg={true}
			category="playlist"
		>
		
	</ContainerThumbnail>





			<ContainerSitelenToki
			name="Reference"
			withImg={true}
			category="listening"
		>
				
		</ContainerSitelenToki>


<h2>Tools</h2>

				<Container_Simple
				name="Online"
				category="tools"
				withImg={false}></Container_Simple>



	</section>
	<section style="grid-area: right;" class="prose">
		<p>Sidebar Content Here</p>
	</section>
</Layout>
