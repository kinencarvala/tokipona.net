---
import FAQChild from "@/layouts/FAQChild.astro";
import { getCollection, getEntry, render } from "astro:content";
const kasi = (
	await getCollection("faqEntries", ({ data }) => {
		return data.published == true && data.faq_group == 3;
	})
).sort((a, b) => a.data.faq_index.valueOf() - b.data.faq_index.valueOf());

---

<style>
	:root{
		--faq-child: black;
	}
	.intro {
		background-color: var(--card-border);
		color: var(--foreground);
		border-radius: var(--rounding-small);
		padding: 1em;
		grid-column: 1 / 3;

		a {
			color: inherit;
		}
	}

	.garden {
		width: 100%;
		max-width: 50em;
		margin: 0 auto;
		display: flex;
		flex-wrap: nowrap;
		position: relative;
		top: 0.4em;
		background-color: black;

		img {
			max-width: 100%;
			user-drag: none;
			user-select: none;
		}
	}
</style>

<FAQChild
	faq_title={"Deeper Insights"}
	title={"The Basics | Toki Pona"}
	description={"This is a test page."}
	draft
	nextLink={undefined}
	prevLink={"/faq/using-toki-pona/"}
	nextText={undefined}


	array={kasi}
>
	<div class="garden">
		{
			kasi.map((item) => (
				<div>
					<img src={`/sitelen/kasi/${item.data.image}`} />
				</div>
			))
		}
	</div>

	<div class="faq">
		<div class="intro">
			<p>Answering questions about Toki Pona that require *slightly* more explanation.
				Click on our inquisitive <a href="https://nimi.li/soweli">soweli</a> if you'd prefer to get to the point with less words.
			</p>

			<p>
				<em
					>Not new around here? Our FAQ has two more sections: <a href="/faq/basics/"
						>Toki Pona: The Basics</a
					> and <a href="/faq/using-toki-pona/">Using Toki Pona</a>.
				</em>
			</p>
		</div>
	</div>
</FAQChild>
